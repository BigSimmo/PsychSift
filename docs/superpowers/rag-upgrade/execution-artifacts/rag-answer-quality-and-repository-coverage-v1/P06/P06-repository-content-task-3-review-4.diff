diff --git a/tests/site-content-sync.test.ts b/tests/site-content-sync.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0e8a0f3f2961d4e9e985f9eefbf030e17cf768ee
--- /dev/null
+++ b/tests/site-content-sync.test.ts
@@ -0,0 +1,330 @@
+import { describe, expect, it, vi } from "vitest";
+
+import {
+  assertSiteReleaseReceiptPair,
+  assertSiteContentSyncPlan,
+  planSiteContentSync,
+  runSiteContentSync,
+} from "../src/lib/site-content/site-content-sync";
+import { activationReceiptDigest, rollbackReceiptDigest } from "../src/lib/recovery-readiness-evidence";
+import {
+  createCandidateProjectionStore,
+  embeddingBytesDigest,
+} from "../src/lib/site-content/site-content-candidate-store";
+
+const sha = (value: string) => `sha256:${value.repeat(64).slice(0, 64)}` as const;
+const releaseId = "11111111-1111-4111-8111-111111111111";
+const priorReleaseId = "22222222-2222-4222-8222-222222222222";
+const generationId = "33333333-3333-4333-8333-333333333333";
+
+function desired(logicalId: string, contentHash: `sha256:${string}`) {
+  return {
+    logicalId,
+    domain: "medications" as const,
+    publicationVersion: "2026-08-24T00:00:00.000Z",
+    contentHash,
+    sourceLineageDigest: sha("a"),
+  };
+}
+
+function plan(overrides: Record<string, unknown> = {}) {
+  return planSiteContentSync({
+    projectRef: "synthetic-project",
+    expectedProjectRef: "synthetic-project",
+    candidateReleaseId: releaseId,
+    previousReleaseId: priorReleaseId,
+    generationId,
+    registryVersion: "site-content-registry-v1",
+    staticManifestDigest: sha("b"),
+    expectedEmbedding: { model: "synthetic-embedding-v1", dimensions: 3 },
+    desiredRecords: [desired("medication:alpha", sha("c")), desired("medication:beta", sha("d"))],
+    activeProjections: [
+      {
+        logicalId: "medication:alpha",
+        contentHash: sha("c"),
+        embedding: {
+          model: "synthetic-embedding-v1",
+          dimensions: 3,
+          contentHash: sha("c"),
+          digest: sha("e"),
+        },
+      },
+      {
+        logicalId: "medication:removed",
+        contentHash: sha("f"),
+        embedding: {
+          model: "synthetic-embedding-v1",
+          dimensions: 3,
+          contentHash: sha("f"),
+          digest: sha("0"),
+        },
+      },
+    ],
+    legacyRows: [],
+    legacyDispositions: [],
+    batchSize: 25,
+    ...overrides,
+  });
+}
+
+describe("durable site-content synchronization", () => {
+  it("plans verified unchanged reuse, changed-only staging, and deletion tombstones deterministically", () => {
+    const result = plan();
+
+    expect(result.mode).toBe("dry-run");
+    expect(result.unchanged.map((entry) => entry.logicalId)).toEqual(["medication:alpha"]);
+    expect(result.changed.map((entry) => entry.logicalId)).toEqual(["medication:beta"]);
+    expect(result.tombstoned.map((entry) => entry.logicalId)).toEqual(["medication:removed"]);
+    expect(result.unchanged[0]?.reusedEmbedding.digest).toBe(sha("e"));
+    expect(result.expectedCounts).toEqual({ desired: 2, changed: 1, unchanged: 1, tombstoned: 1 });
+    expect(result.dynamicStateDigest).toMatch(/^sha256:[a-f0-9]{64}$/);
+    expect(result.releaseDigest).toMatch(/^sha256:[a-f0-9]{64}$/);
+    expect(result.planDigest).toMatch(/^sha256:[a-f0-9]{64}$/);
+    expect(result.recoveryEvidenceDigest).toBeNull();
+    expect(result.operations).toEqual([
+      { logicalId: "medication:alpha", operation: "unchanged", contentHash: sha("c") },
+      { logicalId: "medication:beta", operation: "changed", contentHash: sha("d") },
+      { logicalId: "medication:removed", operation: "tombstone", contentHash: sha("f") },
+    ]);
+    expect(result.legacyDispositions).toEqual([]);
+    expect(assertSiteContentSyncPlan(result)).toEqual(result);
+    expect(plan().planDigest).toBe(result.planDigest);
+  });
+
+  it("fails closed on target drift, incompatible embedding reuse, and unresolved divergent legacy rows", () => {
+    expect(() => plan({ expectedProjectRef: "different-project" })).toThrow(/project/i);
+
+    const incompatible = plan({
+      activeProjections: [
+        {
+          logicalId: "medication:alpha",
+          contentHash: sha("c"),
+          embedding: {
+            model: "old-model",
+            dimensions: 3,
+            contentHash: sha("c"),
+            digest: sha("e"),
+          },
+        },
+      ],
+    });
+    expect(incompatible.changed.map((entry) => entry.logicalId)).toContain("medication:alpha");
+    expect(incompatible.unchanged).toHaveLength(0);
+
+    expect(() =>
+      plan({
+        legacyRows: [
+          { rowId: "legacy-a", logicalId: "medication:alpha", contentHash: sha("1") },
+          { rowId: "legacy-b", logicalId: "medication:alpha", contentHash: sha("2") },
+        ],
+      }),
+    ).toThrow(/disposition|divergent/i);
+    expect(() =>
+      plan({
+        legacyRows: [{ rowId: "row-a", logicalId: "medication:alpha", contentHash: sha("c") }],
+        legacyDispositions: [
+          { logicalId: "medication:alpha", selectedRowId: "row-a", retiredRowIds: [] },
+          { logicalId: "medication:alpha", selectedRowId: "row-a", retiredRowIds: [] },
+        ],
+      }),
+    ).toThrow(/duplicate/i);
+  });
+
+  it("rejects every undeclared, swapped, duplicate, missing, hash, generation, and target plan mutation", () => {
+    const canonical = plan();
+    const mutations = [
+      { ...canonical, projectRef: "foreign-project" },
+      { ...canonical, generationId: "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa" },
+      { ...canonical, operations: canonical.operations.slice(1) },
+      { ...canonical, operations: [...canonical.operations, canonical.operations[0]!] },
+      {
+        ...canonical,
+        operations: canonical.operations.map((operation, index) =>
+          index === 0 ? { ...operation, logicalId: "medication:swapped" } : operation,
+        ),
+      },
+      {
+        ...canonical,
+        operations: canonical.operations.map((operation, index) =>
+          index === 0 ? { ...operation, contentHash: sha("9") } : operation,
+        ),
+      },
+    ];
+    for (const mutation of mutations) expect(() => assertSiteContentSyncPlan(mutation)).toThrow();
+  });
+
+  it("never sends verified unchanged records to the embedding stage and rejects a stale lease or generation", async () => {
+    const syncPlan = plan();
+    const stageChanged = vi.fn(async () => undefined);
+    const carryForward = vi.fn(async () => undefined);
+    const tombstone = vi.fn(async () => undefined);
+    const lease = {
+      workerId: "44444444-4444-4444-8444-444444444444",
+      leaseId: "55555555-5555-4555-8555-555555555555",
+      generationId,
+      expiresAt: "2026-08-24T01:05:00.000Z",
+    };
+
+    await expect(
+      runSiteContentSync(syncPlan, lease, {
+        now: () => new Date("2026-08-24T01:00:00.000Z"),
+        stageChanged,
+        carryForward,
+        tombstone,
+      }),
+    ).resolves.toMatchObject({ changed: 1, unchanged: 1, tombstoned: 1, releaseDigest: syncPlan.releaseDigest });
+    expect(stageChanged).toHaveBeenCalledTimes(1);
+    expect(stageChanged).toHaveBeenCalledWith(expect.objectContaining({ logicalId: "medication:beta" }), lease);
+    expect(carryForward).toHaveBeenCalledWith(
+      expect.objectContaining({ logicalId: "medication:alpha", reusedEmbedding: expect.any(Object) }),
+      lease,
+    );
+    expect(tombstone).toHaveBeenCalledTimes(1);
+
+    await expect(
+      runSiteContentSync(syncPlan, { ...lease, generationId: "66666666-6666-4666-8666-666666666666" }, {}),
+    ).rejects.toThrow(/generation/i);
+    await expect(
+      runSiteContentSync(
+        syncPlan,
+        { ...lease, expiresAt: "2026-08-24T00:59:59.000Z" },
+        {
+          now: () => new Date("2026-08-24T01:00:00.000Z"),
+        },
+      ),
+    ).rejects.toThrow(/lease/i);
+  });
+
+  it("reuses the shared append-only activation and retained-pointer rollback receipt authority", () => {
+    const activation = {
+      version: 1,
+      receiptId: "77777777-7777-4777-8777-777777777777",
+      sequence: 7,
+      recordedAt: "2026-08-24T01:10:00.000Z",
+      projectRef: "synthetic-project",
+      operation: "site-release",
+      recoveryEvidenceId: "88888888-8888-4888-8888-888888888888",
+      recoveryEvidenceDigest: sha("3"),
+      stateDigest: sha("4"),
+      resource: { kind: "site-release", releaseId, releaseDigest: sha("5") },
+      previousResource: { kind: "site-release", releaseId: priorReleaseId, releaseDigest: sha("6") },
+    };
+    const activationWithDigest = { ...activation, digest: activationReceiptDigest(activation) };
+    const rollback = {
+      version: 1,
+      receiptId: "99999999-9999-4999-8999-999999999999",
+      sequence: 8,
+      recordedAt: "2026-08-24T01:11:00.000Z",
+      projectRef: "synthetic-project",
+      operation: "site-release",
+      activationReceiptId: activationWithDigest.receiptId,
+      activationReceiptDigest: activationWithDigest.digest,
+      recoveryEvidenceDigest: activationWithDigest.recoveryEvidenceDigest,
+      failedResource: activationWithDigest.resource,
+      restoredResource: activationWithDigest.previousResource,
+      restorationMethod: "retained-pointer",
+    };
+    const rollbackWithDigest = { ...rollback, digest: rollbackReceiptDigest(rollback) };
+
+    expect(assertSiteReleaseReceiptPair(activationWithDigest, rollbackWithDigest)).toMatchObject({
+      activation: { operation: "site-release" },
+      rollback: { restorationMethod: "retained-pointer" },
+    });
+    const foreignRollback = { ...rollback, projectRef: "foreign-project" };
+    expect(() =>
+      assertSiteReleaseReceiptPair(activationWithDigest, {
+        ...foreignRollback,
+        digest: rollbackReceiptDigest(foreignRollback),
+      }),
+    ).toThrow(/project/i);
+    const staleRollback = { ...rollback, sequence: activation.sequence };
+    expect(() =>
+      assertSiteReleaseReceiptPair(activationWithDigest, {
+        ...staleRollback,
+        digest: rollbackReceiptDigest(staleRollback),
+      }),
+    ).toThrow(/sequence|order/i);
+    const nonPredecessorRollback = {
+      ...rollback,
+      restoredResource: {
+        kind: "site-release" as const,
+        releaseId: "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
+        releaseDigest: sha("8"),
+      },
+    };
+    expect(() =>
+      assertSiteReleaseReceiptPair(activationWithDigest, {
+        ...nonPredecessorRollback,
+        digest: rollbackReceiptDigest(nonPredecessorRollback),
+      }),
+    ).toThrow(/restored|previous|identity/i);
+  });
+
+  it("durably resumes a digest-bound mixed candidate and verifies embedding bytes before reuse", async () => {
+    const reusedBytes = new Float32Array([9, 9, 9]);
+    const syncPlan = plan({
+      activeProjections: [
+        {
+          logicalId: "medication:alpha",
+          contentHash: sha("c"),
+          embedding: {
+            model: "synthetic-embedding-v1",
+            dimensions: 3,
+            contentHash: sha("c"),
+            digest: embeddingBytesDigest(reusedBytes),
+          },
+        },
+        {
+          logicalId: "medication:removed",
+          contentHash: sha("f"),
+          embedding: {
+            model: "synthetic-embedding-v1",
+            dimensions: 3,
+            contentHash: sha("f"),
+            digest: sha("0"),
+          },
+        },
+      ],
+    });
+    const store = createCandidateProjectionStore();
+    const lease = {
+      workerId: "44444444-4444-4444-8444-444444444444",
+      leaseId: "55555555-5555-4555-8555-555555555555",
+      generationId,
+      attempt: 1,
+      expiresAt: "2026-08-24T01:05:00.000Z",
+    };
+    const embed = vi.fn(async () => new Float32Array([1, 2, 3]));
+    await expect(
+      store.resume(syncPlan, lease, {
+        projectRef: "synthetic-project",
+        now: () => new Date("2026-08-24T01:00:00.000Z"),
+        embed,
+        reusedEmbeddingBytes: () => reusedBytes,
+        interruptAfter: 1,
+      }),
+    ).rejects.toThrow(/interrupted/i);
+    const resumedStore = createCandidateProjectionStore(store.exportState());
+    await resumedStore.resume(syncPlan, lease, {
+      projectRef: "synthetic-project",
+      now: () => new Date("2026-08-24T01:00:01.000Z"),
+      embed,
+      reusedEmbeddingBytes: () => reusedBytes,
+    });
+    expect(embed).toHaveBeenCalledTimes(1);
+    expect(resumedStore.snapshot(syncPlan.candidateReleaseId)).toMatchObject({
+      planDigest: syncPlan.planDigest,
+      releaseDigest: syncPlan.releaseDigest,
+      expectedCounts: syncPlan.expectedCounts,
+      completed: true,
+    });
+    await expect(
+      resumedStore.resume({ ...syncPlan, releaseDigest: sha("9") }, lease, {
+        projectRef: "synthetic-project",
+        now: () => new Date("2026-08-24T01:00:02.000Z"),
+        embed,
+        reusedEmbeddingBytes: () => reusedBytes,
+      }),
+    ).rejects.toThrow(/digest|binding/i);
+  });
+});
diff --git a/tests/site-content-transaction-authority.test.ts b/tests/site-content-transaction-authority.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..07f05115a2c30e86289e4c0da736eaf65cfcb832
--- /dev/null
+++ b/tests/site-content-transaction-authority.test.ts
@@ -0,0 +1,198 @@
+import { describe, expect, it } from "vitest";
+
+import { createSiteContentReleaseVerificationEvidence } from "../src/lib/site-content/site-content-release-evidence";
+import {
+  createSiteContentEvidenceValidationBinding,
+  createSiteContentRecoveryValidationBinding,
+  verifySiteContentRecoveryValidationBinding,
+  type SiteContentRecoveryValidationPurpose,
+} from "../src/lib/site-content/site-content-recovery-authority";
+import { planSiteContentSync, type SiteContentSyncPlan } from "../src/lib/site-content/site-content-sync";
+import { createSiteContentTransactionAuthority } from "../src/lib/site-content/site-content-transaction-reference";
+import {
+  fixtureSha,
+  siteReleaseCandidateId,
+  siteReleaseGenerationId,
+  siteReleaseNow,
+  siteReleasePreviousId,
+  siteReleaseProjectRef,
+  validSiteReleaseRecoveryFixture,
+} from "./fixtures/site-release-recovery";
+
+const secret = "synthetic-validation-secret-with-32-bytes";
+const emptyAuthorityId = "00000000-0000-4000-8000-000000000000";
+const recovery = validSiteReleaseRecoveryFixture();
+
+const record = (logicalId: string, contentHash: `sha256:${string}`) => ({
+  logicalId,
+  domain: "medications" as const,
+  recordKind: "medication",
+  slug: logicalId.split(":")[1]!,
+  payload: { logicalId, contentHash },
+  governance: {},
+  publicationVersion: "2026-08-24T00:00:00.000Z",
+  contentHash,
+  sourceLineageDigest: fixtureSha("a"),
+});
+
+function verification(plan: SiteContentSyncPlan) {
+  const logicalIds = plan.operations
+    .filter((operation) => operation.operation !== "tombstone")
+    .map((operation) => operation.logicalId);
+  return createSiteContentReleaseVerificationEvidence(plan, {
+    publicVisibility: { observedLogicalIds: logicalIds, checkedAt: siteReleaseNow.toISOString() },
+    governance: {
+      reviewedLogicalIds: logicalIds,
+      reviewEvidenceDigest: fixtureSha("b"),
+      checkedAt: siteReleaseNow.toISOString(),
+    },
+    mustPass: {
+      caseSetDigest: fixtureSha("c"),
+      caseResults: [{ caseId: "site-content-release", outcome: "passed" }],
+      checkedAt: siteReleaseNow.toISOString(),
+    },
+  });
+}
+
+function evidenceBinding(purpose: "adopt" | "begin" | "verify", payload: unknown) {
+  return createSiteContentEvidenceValidationBinding(purpose, recovery.evidence, payload, {
+    expectedProjectRef: siteReleaseProjectRef,
+    now: siteReleaseNow,
+    secret,
+  });
+}
+
+function authority() {
+  return createSiteContentTransactionAuthority({
+    bindingVerifier: (purpose, payload, binding) =>
+      verifySiteContentRecoveryValidationBinding(binding, {
+        secret,
+        expectedPurpose: purpose as SiteContentRecoveryValidationPurpose,
+        expectedProjectRef: siteReleaseProjectRef,
+        expectedRecoveryEvidenceDigest: recovery.evidence.digest,
+        payload,
+        now: siteReleaseNow,
+      }),
+  });
+}
+
+describe("offline site-content transaction authority", () => {
+  it("uses real signer/verifier bindings to produce empty, current, updating, and atomically activated partitions", () => {
+    const transaction = authority();
+    expect(transaction.partition("medications")).toMatchObject({ state: "unavailable", records: [] });
+    const oldA = record("medication:a", fixtureSha("1"));
+    const stableB = record("medication:b", fixtureSha("2"));
+    const adoptionPlan = planSiteContentSync({
+      projectRef: siteReleaseProjectRef,
+      expectedProjectRef: siteReleaseProjectRef,
+      candidateReleaseId: siteReleasePreviousId,
+      previousReleaseId: emptyAuthorityId,
+      generationId: siteReleaseGenerationId,
+      registryVersion: "site-content-registry-v1",
+      staticManifestDigest: fixtureSha("5"),
+      expectedEmbedding: { model: "synthetic", dimensions: 3 },
+      desiredRecords: [oldA, stableB],
+      activeProjections: [],
+      legacyRows: [],
+      legacyDispositions: [],
+      batchSize: 25,
+      write: true,
+      recoveryEvidence: recovery.evidence,
+      now: siteReleaseNow,
+    });
+    const adoption = { plan: adoptionPlan, records: [oldA, stableB], verificationEvidence: verification(adoptionPlan) };
+    transaction.adoptBaseline(adoption, evidenceBinding("adopt", adoption));
+    expect(transaction.partition("medications")).toMatchObject({ state: "current" });
+
+    const newA = record("medication:a", fixtureSha("3"));
+    const addedC = record("medication:c", fixtureSha("4"));
+    const plan = planSiteContentSync({
+      projectRef: siteReleaseProjectRef,
+      expectedProjectRef: siteReleaseProjectRef,
+      candidateReleaseId: siteReleaseCandidateId,
+      previousReleaseId: siteReleasePreviousId,
+      generationId: siteReleaseGenerationId,
+      registryVersion: "site-content-registry-v1",
+      staticManifestDigest: fixtureSha("5"),
+      expectedEmbedding: { model: "synthetic", dimensions: 3 },
+      desiredRecords: [newA, stableB, addedC],
+      activeProjections: [oldA, stableB].map((entry) => ({
+        logicalId: entry.logicalId,
+        contentHash: entry.contentHash,
+        embedding: { model: "synthetic", dimensions: 3, contentHash: entry.contentHash, digest: fixtureSha("6") },
+      })),
+      legacyRows: [],
+      legacyDispositions: [],
+      batchSize: 25,
+      write: true,
+      recoveryEvidence: recovery.evidence,
+      now: siteReleaseNow,
+    });
+    transaction.beginCandidate(plan, evidenceBinding("begin", plan));
+    transaction.publish(newA);
+    transaction.publish(addedC);
+    expect(transaction.partition("medications")).toMatchObject({
+      state: "updating",
+      records: [expect.objectContaining({ logicalId: "medication:b" })],
+    });
+    for (const operation of plan.operations) transaction.completeOperation(operation);
+    const verificationPayload = { plan, verificationEvidence: verification(plan) };
+    transaction.verifyCandidate(verificationPayload, evidenceBinding("verify", verificationPayload));
+    const activation = validSiteReleaseRecoveryFixture({
+      candidateReleaseDigest: plan.releaseDigest,
+      previousReleaseDigest: adoptionPlan.releaseDigest,
+      stateDigest: plan.dynamicStateDigest,
+    }).activation;
+    const activationPayload = { action: "activate" as const, evidence: recovery.evidence, activation };
+    const activationBinding = createSiteContentRecoveryValidationBinding(
+      {
+        ...activationPayload,
+        expected: {
+          resource: activation.resource,
+          previousResource: activation.previousResource,
+          stateDigest: activation.stateDigest,
+        },
+      },
+      { expectedProjectRef: siteReleaseProjectRef, now: siteReleaseNow, secret },
+    );
+    transaction.activate(plan.candidateReleaseId, activationPayload, activationBinding);
+    expect(transaction.partition("medications")).toMatchObject({
+      state: "current",
+      records: [
+        expect.objectContaining({ logicalId: "medication:a" }),
+        expect.objectContaining({ logicalId: "medication:b" }),
+        expect.objectContaining({ logicalId: "medication:c" }),
+      ],
+    });
+  });
+
+  it("rejects a binding signed with a disconnected secret", () => {
+    const transaction = authority();
+    const baseline = record("medication:a", fixtureSha("1"));
+    const plan = planSiteContentSync({
+      projectRef: siteReleaseProjectRef,
+      expectedProjectRef: siteReleaseProjectRef,
+      candidateReleaseId: siteReleasePreviousId,
+      previousReleaseId: emptyAuthorityId,
+      generationId: siteReleaseGenerationId,
+      registryVersion: "site-content-registry-v1",
+      staticManifestDigest: fixtureSha("5"),
+      expectedEmbedding: { model: "synthetic", dimensions: 3 },
+      desiredRecords: [baseline],
+      activeProjections: [],
+      legacyRows: [],
+      legacyDispositions: [],
+      batchSize: 25,
+      write: true,
+      recoveryEvidence: recovery.evidence,
+      now: siteReleaseNow,
+    });
+    const adoption = { plan, records: [baseline], verificationEvidence: verification(plan) };
+    const forged = createSiteContentEvidenceValidationBinding("adopt", recovery.evidence, adoption, {
+      expectedProjectRef: siteReleaseProjectRef,
+      now: siteReleaseNow,
+      secret: "different-synthetic-validation-secret-32-bytes",
+    });
+    expect(() => transaction.adoptBaseline(adoption, forged)).toThrow(/binding/i);
+  });
+});
