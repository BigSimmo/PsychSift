index 0000000000000000000000000000000000000000..7a2cb5e2077bd7dd8dbfc26569ca88a2c57b1f7a
--- /dev/null
+++ b/src/lib/site-content/public-site-content.ts
@@ -0,0 +1,67 @@
+import type { SiteContentDomain, SiteContentPartitionState } from "@/lib/types";
+
+type RpcClient = Pick<ReturnType<typeof import("@/lib/supabase/admin").createAdminClient>, "rpc">;
+
+export type PublicSiteContentRecord<T> = Readonly<{
+  logical_id: string;
+  payload: T;
+  governance: Record<string, unknown>;
+  publication_version: string;
+  content_hash: string;
+  source_lineage_digest: string;
+}>;
+
+export type PublicSiteContentPartition<T> = Readonly<{
+  activeReleaseId: string | null;
+  changeEpoch: number;
+  state: SiteContentPartitionState;
+  records: PublicSiteContentRecord<T>[];
+}>;
+
+export async function readPublicSiteContentPartition<T>(
+  client: RpcClient,
+  input: { domain: SiteContentDomain; recordKind?: string; slug?: string },
+): Promise<PublicSiteContentPartition<T> | null> {
+  const { data, error } = await client.rpc("read_public_site_content_records", {
+    p_domain: input.domain,
+    p_record_kind: input.recordKind ?? null,
+    p_slug: input.slug ?? null,
+  });
+  if (error) {
+    // The migration is forward-only; bundled public fixtures remain the explicit
+    // fallback until the release authority is applied by an operator.
+    if (error.code === "42883") return null;
+    throw new Error("Canonical public site-content read failed.");
+  }
+  if (!data || typeof data !== "object" || !Array.isArray((data as { records?: unknown }).records)) {
+    throw new Error("Canonical public site-content response is invalid.");
+  }
+  const partition = data as PublicSiteContentPartition<T>;
+  const activeReleaseValid =
+    partition.activeReleaseId === null ||
+    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(partition.activeReleaseId);
+  const recordsValid = partition.records.every(
+    (record) =>
+      record &&
+      typeof record.logical_id === "string" &&
+      record.logical_id.length > 0 &&
+      record.payload !== null &&
+      typeof record.payload === "object" &&
+      record.governance !== null &&
+      typeof record.governance === "object" &&
+      /^sha256:[a-f0-9]{64}$/.test(record.content_hash) &&
+      /^sha256:[a-f0-9]{64}$/.test(record.source_lineage_digest),
+  );
+  if (
+    !Number.isSafeInteger(partition.changeEpoch) ||
+    partition.changeEpoch < 0 ||
+    !["current", "updating", "unavailable"].includes(partition.state) ||
+    !activeReleaseValid ||
+    !recordsValid ||
+    (partition.state === "unavailable" && (partition.activeReleaseId !== null || partition.records.length > 0)) ||
+    (partition.state !== "unavailable" && partition.activeReleaseId === null)
+  ) {
+    throw new Error("Canonical public site-content response is invalid.");
+  }
+  return partition;
+}
diff --git a/src/lib/site-content/site-content-candidate-store.ts b/src/lib/site-content/site-content-candidate-store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..65c2698793569fae6062d1792a163e406318d8df
--- /dev/null
+++ b/src/lib/site-content/site-content-candidate-store.ts
@@ -0,0 +1,204 @@
+import { createHash } from "node:crypto";
+
+import type { SiteContentSyncPlan, SiteContentWorkerLease } from "@/lib/site-content/site-content-sync";
+
+type Digest = `sha256:${string}`;
+type CandidateLease = SiteContentWorkerLease & { attempt: number };
+
+type Projection = Readonly<{
+  logicalId: string;
+  contentHash: Digest;
+  embeddingModel: string | null;
+  embeddingDimensions: number | null;
+  embeddingDigest: Digest | null;
+  tombstoned: boolean;
+}>;
+
+type CandidateState = {
+  projectRef: string;
+  generationId: string;
+  planDigest: Digest;
+  releaseDigest: Digest;
+  staticManifestDigest: Digest;
+  dynamicStateDigest: Digest;
+  embeddingContract: SiteContentSyncPlan["embeddingContract"];
+  expectedCounts: SiteContentSyncPlan["expectedCounts"];
+  applied: Set<string>;
+  projections: Map<string, Projection>;
+  completed: boolean;
+};
+
+type ResumeRuntime = {
+  projectRef: string;
+  now: () => Date;
+  embed: (logicalId: string) => Promise<Float32Array>;
+  reusedEmbeddingBytes: (logicalId: string) => Float32Array;
+  assertLease?: (lease: CandidateLease) => void | Promise<void>;
+  interruptAfter?: number;
+};
+
+export function embeddingBytesDigest(bytes: Float32Array): Digest {
+  return `sha256:${createHash("sha256")
+    .update(new Uint8Array(bytes.buffer, bytes.byteOffset, bytes.byteLength))
+    .digest("hex")}`;
+}
+
+function assertLease(plan: SiteContentSyncPlan, lease: CandidateLease, runtime: ResumeRuntime) {
+  if (lease.generationId !== plan.generationId || !Number.isInteger(lease.attempt) || lease.attempt < 1) {
+    throw new Error("Candidate lease generation/attempt binding mismatch.");
+  }
+  if (Date.parse(lease.expiresAt) <= runtime.now().getTime()) throw new Error("Candidate lease expired.");
+}
+
+export type CandidateProjectionStoreState = ReadonlyArray<
+  Omit<CandidateState, "applied" | "projections"> & {
+    candidateReleaseId: string;
+    applied: string[];
+    projections: Projection[];
+  }
+>;
+
+export function createCandidateProjectionStore(initial: CandidateProjectionStoreState = []) {
+  const candidates = new Map<string, CandidateState>();
+  for (const persisted of initial) {
+    candidates.set(persisted.candidateReleaseId, {
+      ...persisted,
+      applied: new Set(persisted.applied),
+      projections: new Map(persisted.projections.map((projection) => [projection.logicalId, projection])),
+    });
+  }
+
+  async function resume(plan: SiteContentSyncPlan, lease: CandidateLease, runtime: ResumeRuntime) {
+    assertLease(plan, lease, runtime);
+    await runtime.assertLease?.(lease);
+    const existing = candidates.get(plan.candidateReleaseId);
+    const state: CandidateState = existing ?? {
+      projectRef: runtime.projectRef,
+      generationId: plan.generationId,
+      planDigest: plan.planDigest,
+      releaseDigest: plan.releaseDigest,
+      staticManifestDigest: plan.staticManifestDigest,
+      dynamicStateDigest: plan.dynamicStateDigest,
+      embeddingContract: plan.embeddingContract,
+      expectedCounts: plan.expectedCounts,
+      applied: new Set(),
+      projections: new Map(),
+      completed: false,
+    };
+    const expectedBinding = JSON.stringify({
+      projectRef: runtime.projectRef,
+      generationId: plan.generationId,
+      planDigest: plan.planDigest,
+      releaseDigest: plan.releaseDigest,
+      staticManifestDigest: plan.staticManifestDigest,
+      dynamicStateDigest: plan.dynamicStateDigest,
+      embeddingContract: plan.embeddingContract,
+      expectedCounts: plan.expectedCounts,
+    });
+    const actualBinding = JSON.stringify({
+      projectRef: state.projectRef,
+      generationId: state.generationId,
+      planDigest: state.planDigest,
+      releaseDigest: state.releaseDigest,
+      staticManifestDigest: state.staticManifestDigest,
+      dynamicStateDigest: state.dynamicStateDigest,
+      embeddingContract: state.embeddingContract,
+      expectedCounts: state.expectedCounts,
+    });
+    if (expectedBinding !== actualBinding) throw new Error("Candidate target/digest/count binding mismatch.");
+    candidates.set(plan.candidateReleaseId, state);
+
+    let mutations = 0;
+    const beforeMutation = async () => {
+      assertLease(plan, lease, runtime);
+      await runtime.assertLease?.(lease);
+    };
+    for (const record of plan.changed) {
+      if (state.applied.has(`changed:${record.logicalId}`)) continue;
+      await beforeMutation();
+      const bytes = await runtime.embed(record.logicalId);
+      await beforeMutation();
+      if (bytes.length !== plan.embeddingContract.dimensions) {
+        throw new Error("Generated embedding model/dimension binding mismatch.");
+      }
+      state.projections.set(record.logicalId, {
+        logicalId: record.logicalId,
+        contentHash: record.contentHash,
+        embeddingModel: plan.embeddingContract.model,
+        embeddingDimensions: bytes.length,
+        embeddingDigest: embeddingBytesDigest(bytes),
+        tombstoned: false,
+      });
+      state.applied.add(`changed:${record.logicalId}`);
+      mutations += 1;
+      if (mutations === runtime.interruptAfter) throw new Error("Synthetic candidate synchronization interrupted.");
+    }
+    for (const record of plan.unchanged) {
+      if (state.applied.has(`unchanged:${record.logicalId}`)) continue;
+      await beforeMutation();
+      const bytes = runtime.reusedEmbeddingBytes(record.logicalId);
+      if (
+        bytes.length !== record.reusedEmbedding.dimensions ||
+        embeddingBytesDigest(bytes) !== record.reusedEmbedding.digest
+      ) {
+        throw new Error("Verified embedding byte/model/dimension reuse mismatch.");
+      }
+      state.projections.set(record.logicalId, {
+        logicalId: record.logicalId,
+        contentHash: record.contentHash,
+        embeddingModel: record.reusedEmbedding.model,
+        embeddingDimensions: record.reusedEmbedding.dimensions,
+        embeddingDigest: record.reusedEmbedding.digest,
+        tombstoned: false,
+      });
+      state.applied.add(`unchanged:${record.logicalId}`);
+      mutations += 1;
+      if (mutations === runtime.interruptAfter) throw new Error("Synthetic candidate synchronization interrupted.");
+    }
+    for (const record of plan.tombstoned) {
+      if (state.applied.has(`tombstone:${record.logicalId}`)) continue;
+      await beforeMutation();
+      state.projections.set(record.logicalId, {
+        logicalId: record.logicalId,
+        contentHash: record.priorContentHash,
+        embeddingModel: null,
+        embeddingDimensions: null,
+        embeddingDigest: null,
+        tombstoned: true,
+      });
+      state.applied.add(`tombstone:${record.logicalId}`);
+      mutations += 1;
+      if (mutations === runtime.interruptAfter) throw new Error("Synthetic candidate synchronization interrupted.");
+    }
+    state.completed = state.applied.size === plan.changed.length + plan.unchanged.length + plan.tombstoned.length;
+    return state;
+  }
+
+  function snapshot(candidateReleaseId: string) {
+    const state = candidates.get(candidateReleaseId);
+    if (!state) return null;
+    return Object.freeze({
+      projectRef: state.projectRef,
+      generationId: state.generationId,
+      planDigest: state.planDigest,
+      releaseDigest: state.releaseDigest,
+      staticManifestDigest: state.staticManifestDigest,
+      dynamicStateDigest: state.dynamicStateDigest,
+      embeddingContract: state.embeddingContract,
+      expectedCounts: state.expectedCounts,
+      completed: state.completed,
+      projections: [...state.projections.values()],
+    });
+  }
+
+  function exportState(): CandidateProjectionStoreState {
+    return [...candidates.entries()].map(([candidateReleaseId, state]) => ({
+      candidateReleaseId,
+      ...state,
+      applied: [...state.applied],
+      projections: [...state.projections.values()],
+    }));
+  }
+
+  return Object.freeze({ resume, snapshot, exportState });
+}
diff --git a/src/lib/site-content/site-content-recovery-authority.ts b/src/lib/site-content/site-content-recovery-authority.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c3e94c12df80bd5feda42a97feb0f68f81e4f66f
--- /dev/null
+++ b/src/lib/site-content/site-content-recovery-authority.ts
@@ -0,0 +1,201 @@
+import { createHmac, timingSafeEqual } from "node:crypto";
+
+import {
+  assertActivationReceiptBinding,
+  assertRecoveryReadinessForOperation,
+  assertRollbackReceiptBinding,
+  parseRecoveryReadinessEvidence,
+  type ActivationReceipt,
+  type RecoveryReadinessEvidence,
+  type RollbackReceipt,
+} from "@/lib/recovery-readiness-evidence";
+import {
+  assertSiteContentSyncPlan,
+  siteContentSyncCanonicalJson,
+  siteContentSyncDigest,
+} from "@/lib/site-content/site-content-sync";
+import { assertSiteContentReleaseVerificationEvidence } from "@/lib/site-content/site-content-release-evidence";
+
+export type SiteContentRecoveryValidationPurpose = "adopt" | "begin" | "verify" | "activate" | "rollback";
+
+export type SiteContentRecoveryValidationBinding = Readonly<{
+  version: "site-content-recovery-validation-v1";
+  purpose: SiteContentRecoveryValidationPurpose;
+  projectRef: string;
+  recoveryEvidenceDigest: `sha256:${string}`;
+  payloadDigest: `sha256:${string}`;
+  validatedAt: string;
+  mac: string;
+}>;
+
+type ActivationInput = {
+  action: "activate";
+  evidence: unknown;
+  activation: unknown;
+  rollback?: undefined;
+  expected: Pick<ActivationReceipt, "resource" | "previousResource" | "stateDigest">;
+};
+
+type RollbackInput = {
+  action: "rollback";
+  evidence: unknown;
+  activation: unknown;
+  rollback: unknown;
+  expected: Pick<ActivationReceipt, "resource" | "previousResource" | "stateDigest">;
+};
+
+function bindingMac(binding: Omit<SiteContentRecoveryValidationBinding, "mac">, secret: string) {
+  if (secret.length < 16) throw new Error("Site-content recovery validation secret is not configured safely.");
+  return createHmac("sha256", secret).update(siteContentSyncCanonicalJson(binding)).digest("hex");
+}
+
+function assertSiteReleaseReceipt(receipt: ActivationReceipt) {
+  if (
+    receipt.operation !== "site-release" ||
+    receipt.resource.kind !== "site-release" ||
+    receipt.previousResource.kind !== "site-release"
+  ) {
+    throw new Error("Exact site-release activation identities are required.");
+  }
+}
+
+function assertEvidenceTransitionPayload(
+  purpose: Exclude<SiteContentRecoveryValidationPurpose, "activate" | "rollback">,
+  payload: unknown,
+) {
+  if (purpose === "begin") return assertSiteContentSyncPlan(payload);
+  if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
+    throw new Error("Canonical site-content evidence transition payload is required.");
+  }
+  const transition = payload as { plan?: unknown; verificationEvidence?: unknown; records?: unknown };
+  const plan = assertSiteContentSyncPlan(transition.plan);
+  assertSiteContentReleaseVerificationEvidence(transition.verificationEvidence, plan);
+  if (purpose === "adopt") {
+    if (!Array.isArray(transition.records)) throw new Error("Adoption records are required.");
+    const expected = plan.operations
+      .filter((operation) => operation.operation !== "tombstone")
+      .map(({ logicalId, contentHash }) => ({ logicalId, contentHash }))
+      .sort((left, right) => left.logicalId.localeCompare(right.logicalId));
+    const actual = transition.records
+      .map((record) => {
+        if (!record || typeof record !== "object") throw new Error("Adoption record is invalid.");
+        const value = record as { logicalId?: unknown; contentHash?: unknown };
+        return { logicalId: value.logicalId, contentHash: value.contentHash };
+      })
+      .sort((left, right) => String(left.logicalId).localeCompare(String(right.logicalId)));
+    if (JSON.stringify(actual) !== JSON.stringify(expected)) {
+      throw new Error("Adoption records do not match the canonical plan population.");
+    }
+  }
+  return plan;
+}
+
+export function createSiteContentEvidenceValidationBinding(
+  purpose: Exclude<SiteContentRecoveryValidationPurpose, "activate" | "rollback">,
+  evidenceInput: unknown,
+  payload: unknown,
+  options: { expectedProjectRef: string; now: Date; secret: string },
+): SiteContentRecoveryValidationBinding {
+  const evidence = parseRecoveryReadinessEvidence(evidenceInput);
+  assertRecoveryReadinessForOperation(evidence, "site-release", options.expectedProjectRef, options.now);
+  const plan = assertEvidenceTransitionPayload(purpose, payload);
+  if (plan.projectRef !== options.expectedProjectRef || plan.recoveryEvidenceDigest !== evidence.digest) {
+    throw new Error("Evidence transition plan/recovery identity mismatch.");
+  }
+  const withoutMac = {
+    version: "site-content-recovery-validation-v1" as const,
+    purpose,
+    projectRef: options.expectedProjectRef,
+    recoveryEvidenceDigest: evidence.digest as `sha256:${string}`,
+    payloadDigest: siteContentSyncDigest(payload),
+    validatedAt: options.now.toISOString(),
+  };
+  return Object.freeze({ ...withoutMac, mac: bindingMac(withoutMac, options.secret) });
+}
+
+export function createSiteContentRecoveryValidationBinding(
+  input: ActivationInput | RollbackInput,
+  options: { expectedProjectRef: string; now: Date; secret: string },
+): SiteContentRecoveryValidationBinding {
+  const evidence = parseRecoveryReadinessEvidence(input.evidence);
+  const activation = assertActivationReceiptBinding(
+    input.activation,
+    evidence,
+    options.expectedProjectRef,
+    options.now,
+  );
+  assertSiteReleaseReceipt(activation);
+  if (
+    siteContentSyncDigest({
+      resource: activation.resource,
+      previousResource: activation.previousResource,
+      stateDigest: activation.stateDigest,
+    }) !== siteContentSyncDigest(input.expected)
+  ) {
+    throw new Error("Activation target, predecessor, or state digest binding mismatch.");
+  }
+  let rollback: RollbackReceipt | undefined;
+  if (input.action === "rollback") {
+    rollback = assertRollbackReceiptBinding(
+      input.rollback,
+      activation,
+      evidence,
+      options.expectedProjectRef,
+      options.now,
+    );
+  }
+  const payload = {
+    action: input.action,
+    evidence,
+    activation,
+    ...(rollback ? { rollback } : {}),
+  };
+  const withoutMac = {
+    version: "site-content-recovery-validation-v1" as const,
+    purpose: input.action,
+    projectRef: options.expectedProjectRef,
+    recoveryEvidenceDigest: evidence.digest as `sha256:${string}`,
+    payloadDigest: siteContentSyncDigest(payload),
+    validatedAt: options.now.toISOString(),
+  };
+  return Object.freeze({ ...withoutMac, mac: bindingMac(withoutMac, options.secret) });
+}
+
+export function verifySiteContentRecoveryValidationBinding(
+  input: SiteContentRecoveryValidationBinding,
+  options: {
+    secret: string;
+    expectedPurpose: SiteContentRecoveryValidationPurpose;
+    expectedProjectRef: string;
+    expectedRecoveryEvidenceDigest: string;
+    payload: unknown;
+    now: Date;
+  },
+) {
+  try {
+    const { mac, ...withoutMac } = input;
+    const validatedAt = Date.parse(input.validatedAt);
+    if (
+      !/^[a-f0-9]{64}$/.test(mac) ||
+      input.version !== "site-content-recovery-validation-v1" ||
+      input.purpose !== options.expectedPurpose ||
+      input.projectRef !== options.expectedProjectRef ||
+      input.recoveryEvidenceDigest !== options.expectedRecoveryEvidenceDigest ||
+      input.payloadDigest !== siteContentSyncDigest(options.payload) ||
+      !Number.isFinite(validatedAt) ||
+      Math.abs(options.now.getTime() - validatedAt) > 5 * 60 * 1000
+    ) {
+      return false;
+    }
+    const expected = bindingMac(withoutMac, options.secret);
+    return timingSafeEqual(Buffer.from(mac, "hex"), Buffer.from(expected, "hex"));
+  } catch {
+    return false;
+  }
+}
+
+export function siteContentRecoveryBindingPayload(purpose: SiteContentRecoveryValidationPurpose, payload: unknown) {
+  return { purpose, payloadDigest: siteContentSyncDigest(payload) } as const;
+}
+
+export type { RecoveryReadinessEvidence };
