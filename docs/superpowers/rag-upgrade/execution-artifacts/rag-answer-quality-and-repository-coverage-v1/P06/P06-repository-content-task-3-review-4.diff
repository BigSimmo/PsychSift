+    const processEvent = vi.fn(async () => ({ releaseId: "55555555-5555-4555-8555-555555555555" }));
+
+    const result = await drainSiteContentSyncBatch({
+      workerId: "66666666-6666-4666-8666-666666666666",
+      limit: 500,
+      leaseSeconds: 90,
+      maxBatchSize: 25,
+      maxAttempts: 4,
+      rpc,
+      processEvent,
+      heartbeatEvery: 1,
+      log: vi.fn(),
