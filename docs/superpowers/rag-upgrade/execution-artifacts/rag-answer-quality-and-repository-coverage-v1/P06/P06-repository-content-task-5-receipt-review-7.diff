+    version: "rag-context-snapshot-v1",
+    resolvedAt,
+    documentIndexGeneration: input.documentIndexGeneration,
+    sourcePolicyVersion: input.sourcePolicyVersion,
+    rolloutVersion: input.rolloutVersion,
+    uploadedLocal: input.uploadedLocal
