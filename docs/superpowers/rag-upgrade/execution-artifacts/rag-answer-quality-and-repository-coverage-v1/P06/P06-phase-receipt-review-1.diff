index 0000000000000000000000000000000000000000..b66cf83ecf7bfb129e8cb27ee0e11dc9feabd947
--- /dev/null
+++ b/tests/site-content-authority-secret-provisioning.test.ts
@@ -0,0 +1,78 @@
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { describe, expect, it } from "vitest";
+
+import { prepareSiteContentAuthoritySecretProvisioning } from "../src/lib/site-content/site-content-authority-secrets";
+
+const root = resolve(import.meta.dirname, "..");
+const secrets = {
+  recoveryValidationSecret: "recovery-validation-secret-00000001",
+  governanceOwnerSecret: "governance-owner-secret-0000000002",
+  ragProgrammeOwnerSecret: "rag-programme-owner-secret-00000003",
+};
+
+describe("site-content fixed-purpose secret provisioning", () => {
+  it("selects only fixed owner RPCs and rejects absent or cross-purpose duplicate configuration", () => {
+    expect(
+      prepareSiteContentAuthoritySecretProvisioning("governance", secrets, {
+        expectedCurrentDigest: null,
+        rotationReason: null,
+      }),
+    ).toEqual({
+      rpc: "provision_site_content_governance_gate_owner_secret",
+      configuration: {
+        secret: secrets.governanceOwnerSecret,
+        expectedCurrentDigest: null,
+        rotationReason: null,
+      },
+    });
+    expect(
+      prepareSiteContentAuthoritySecretProvisioning("must-pass", secrets, {
+        expectedCurrentDigest: "sha256:" + "a".repeat(64),
+        rotationReason: "scheduled rotation",
+      }).rpc,
+    ).toBe("provision_rag_programme_gate_owner_secret");
+    expect(() =>
+      prepareSiteContentAuthoritySecretProvisioning(
+        "governance",
+        { ...secrets, governanceOwnerSecret: secrets.recoveryValidationSecret },
+        { expectedCurrentDigest: null, rotationReason: null },
+      ),
+    ).toThrow(/distinct/i);
+    expect(() =>
+      prepareSiteContentAuthoritySecretProvisioning(
+        "must-pass",
+        { ...secrets, ragProgrammeOwnerSecret: "" },
+        { expectedCurrentDigest: null, rotationReason: null },
+      ),
+    ).toThrow(/configured/i);
+    expect(() =>
+      prepareSiteContentAuthoritySecretProvisioning("recovery", secrets, {
+        expectedCurrentDigest: "sha256:" + "b".repeat(64),
+        rotationReason: null,
+      }),
+    ).toThrow(/rotation reason/i);
+  });
+
+  it("uses three least-privilege write-once Vault authorities with cross-purpose digest rejection", () => {
+    const sql = readFileSync(
+      resolve(root, "supabase/migrations/20260824130000_add_site_content_release_and_outbox.sql"),
+      "utf8",
+    );
+    for (const name of [
+      "provision_site_content_validation_secret",
+      "provision_site_content_governance_gate_owner_secret",
+      "provision_rag_programme_gate_owner_secret",
+    ]) {
+      expect(sql).toMatch(new RegExp(`create or replace function public\\.${name}\\(p_configuration jsonb\\)`, "i"));
+      expect(sql).toMatch(new RegExp(`grant execute on function public\\.${name}\\(jsonb\\) to service_role`, "i"));
+      expect(sql).not.toMatch(new RegExp(`grant execute on function public\\.${name}[^;]*to authenticated`, "i"));
+    }
+    expect(sql).toMatch(/site_content_governance_gate_owner_secret[\s\S]*rag_programme_gate_owner_secret/i);
+    expect(sql).toMatch(/cross-purpose site-content authority secrets must be distinct/i);
+    expect(sql.match(/hashtextextended\('site_content_authority_secrets',0\)/g)).toHaveLength(3);
+    expect(sql).toMatch(/initial secret provisioning cannot claim a predecessor/i);
+    expect(sql).toMatch(/exact predecessor digest and reason/i);
+    expect(sql).not.toMatch(/create or replace function public\.provision_site_content_secret\([^)]*secret_name/i);
+  });
+});
diff --git a/tests/site-content-freshness-workflow.test.ts b/tests/site-content-freshness-workflow.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5a9a630f31d7616391e79b4089a52acc814cd873
--- /dev/null
+++ b/tests/site-content-freshness-workflow.test.ts
@@ -0,0 +1,74 @@
+import { execFileSync, spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+
+import { afterEach, describe, expect, it } from "vitest";
+
+const fixturePath = resolve("tests/fixtures/site-content/release-evidence-current.json");
+const temporaryDirectories: string[] = [];
+
+afterEach(() => {
+  for (const directory of temporaryDirectories.splice(0)) rmSync(directory, { recursive: true, force: true });
+});
+
+function runFreshness(args: string[]) {
+  return spawnSync(process.execPath, ["scripts/run-tsx.mjs", "scripts/check-site-content-freshness.ts", ...args], {
+    cwd: process.cwd(),
+    encoding: "utf8",
+  });
+}
+
+describe("site-content freshness workflow", () => {
+  it("accepts the provider-free current release evidence through the offline default", () => {
+    const result = runFreshness(["--evidence", fixturePath]);
+
+    expect(result.status, result.stderr).toBe(0);
+    expect(JSON.parse(result.stdout)).toMatchObject({ state: "current", staticManifestMatch: true });
+  });
+
+  it("fails promotion for a static deployment/release mismatch", () => {
+    const temporaryDirectory = mkdtempSync(join(tmpdir(), "site-content-freshness-"));
+    temporaryDirectories.push(temporaryDirectory);
+    const evidence = JSON.parse(readFileSync(fixturePath, "utf8")) as Record<string, unknown>;
+    evidence.deploymentSha = "9".repeat(40);
+    const path = join(temporaryDirectory, "mismatch.json");
+    writeFileSync(path, `${JSON.stringify(evidence)}\n`, "utf8");
+
+    const result = runFreshness(["--evidence", path]);
+
+    expect(result.status).toBe(1);
+    expect(result.stderr).toContain("deployment_sha_mismatch");
+  });
+
+  it("keeps live reads explicitly unavailable in the offline checker", () => {
+    const result = runFreshness(["--live"]);
+
+    expect(result.status).toBe(1);
+    expect(result.stderr).toContain("approval-gated");
+  });
+
+  it("routes only selected site-content changes through manifest and domain-fixture validation", () => {
+    const workflow = readFileSync(".github/workflows/ci.yml", "utf8");
+    const step = workflow.match(
+      /- name: Site-content manifest and domain fixture validation[\s\S]*?(?=\n\s{6}- name:|\n\s{2}[a-z-]+:)/,
+    )?.[0];
+
+    expect(step).toBeDefined();
+    expect(step).toContain("needs.changes.outputs.site_content_changed == 'true'");
+    expect(step).toContain("scripts/build-site-content-manifest.ts --check");
+    expect(step).toContain("tests/site-content-manifest.test.ts");
+    expect(step).toContain("tests/site-content-registry.test.ts");
+    expect(step).not.toMatch(/sync-site-content-corpus|--write|supabase|provider/i);
+  });
+
+  it("keeps the manifest/domain fixture command provider-free and runnable", () => {
+    const output = execFileSync(
+      process.execPath,
+      ["scripts/run-tsx.mjs", "scripts/build-site-content-manifest.ts", "--check"],
+      { encoding: "utf8" },
+    );
+
+    expect(output).toMatch(/site-content manifest check passed:/);
+  });
+});
