+  values((p_fence->>'job_id')::uuid,v_document_id,p_fence->>'job_kind',(p_fence->>'lease_token')::uuid,
+    (p_fence->>'expected_generation_id')::uuid,p_stage,p_metadata) returning id into v_stage;
