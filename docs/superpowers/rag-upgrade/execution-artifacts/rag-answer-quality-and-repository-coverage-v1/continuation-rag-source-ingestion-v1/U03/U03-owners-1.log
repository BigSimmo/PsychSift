"import { assertUnleasedOperatorModeAllowed, isDirectScriptInvocation, unavailableUnleasedIngestionOperation } from \"./lib/ingestion-operator-compatibility\";
import { createHash } from \"node:crypto\";
import { loadEnvConfig } from \"@next/env\";
import {
  SOURCE_ANCHORED_MAX_CHUNKS,
  SOURCE_ANCHORED_MAX_IMAGES,
