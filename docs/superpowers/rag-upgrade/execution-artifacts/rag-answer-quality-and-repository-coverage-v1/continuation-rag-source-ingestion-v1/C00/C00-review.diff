+export type ProviderEgressPermit = Readonly<{
+  binding: ProviderEgressBinding;
+  evidenceDigest: string;
+  policyVersion: string;
+  purpose: ProviderEgressPurpose;
+  [providerEgressPermitBrand]: true;
+}>;
