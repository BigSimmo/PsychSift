+      item.estimatedCostUsd !== null && isFiniteNonNegative(item.estimatedCostUsd) ? item.estimatedCostUsd : null,
+    ),
+  );
+  const candidateCost = sumKnown(
+    candidate.cases.map((item) =>
+      item.estimatedCostUsd !== null && isFiniteNonNegative(item.estimatedCostUsd) ? item.estimatedCostUsd : null,
+    ),
+  );
