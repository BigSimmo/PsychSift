+
+function sseInteractionId(body: string) {
+  const data = body
+    .split(/\n\n+/)
+    .map((frame) => frame.split("\n"))
+    .find((lines) => lines.includes("event: final"))
+    ?.find((line) => line.startsWith("data: "))
