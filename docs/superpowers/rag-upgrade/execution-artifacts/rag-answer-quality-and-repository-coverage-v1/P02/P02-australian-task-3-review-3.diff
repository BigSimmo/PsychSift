+    }
+  | {
+      selected: "none";
+      reason: "no_eligible_primary_evidence";
+    };
+
+export type SourcePolicyConflict = {
+  version: "source-policy-conflict-v1";
+  id: string;
+  claimRole: ClinicalClaimRole;
