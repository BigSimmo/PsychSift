+
 export type ReindexQueueSnapshot = {
   openJobs: number;
   queuedDocuments: number;
   processingDocuments: number;
   failedDocuments: number;
 };
 
 export type AbandonedReindexGenerationCounts = {
   document_chunks?: number;
