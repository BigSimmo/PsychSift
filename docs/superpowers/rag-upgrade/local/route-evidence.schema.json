{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-kb.local/schemas/rag-upgrade-route-evidence-v1.json",
  "title": "Sanitized authoritative Codex route evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "source",
    "sourceEventId",
    "capturedAt",
    "agentId",
    "runtimeHost",
    "provider",
    "plannedModel",
    "actualModel",
    "plannedReasoning",
    "actualReasoning",
    "providerMappingUsed",
    "fallbackUsed",
    "escalationUsed",
    "capabilityClass",
    "sanitized"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceKind": { "const": "codex-authoritative-route" },
    "source": { "enum": ["codex-host-runtime-metadata", "codex-dispatch-metadata"] },
    "sourceEventId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "agentId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "runtimeHost": { "enum": ["codex-cloud", "codex-desktop"] },
    "provider": { "const": "codex" },
    "plannedModel": { "enum": ["gpt-5.6-sol", "gpt-5.6-terra"] },
    "actualModel": { "enum": ["gpt-5.6-sol", "gpt-5.6-terra"] },
    "plannedReasoning": { "enum": ["high", "xhigh"] },
    "actualReasoning": { "enum": ["high", "xhigh"] },
    "providerMappingUsed": { "const": false },
    "fallbackUsed": { "const": false },
    "escalationUsed": { "type": "boolean" },
    "capabilityClass": { "enum": ["frontier-high", "workhorse-high"] },
    "sanitized": { "const": true }
  }
}
