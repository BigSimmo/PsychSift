{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-kb.local/schemas/rag-upgrade-connected-phase-receipt-v1.json",
  "title": "RAG upgrade local connected phase receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "programmeId",
    "phaseId",
    "executionPredecessor",
    "status",
    "decision",
    "branch",
    "offlineProgrammeBinding",
    "phaseStartSha",
    "phaseEndSha",
    "controllerRouting",
    "reviewerRouting",
    "phaseReview",
    "capabilityEvidence",
    "approvals",
    "operations",
    "evidenceArtifacts",
    "closesGate",
    "remainingResidualGates",
    "startedAt",
    "completedAt",
    "acceptedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "programmeId": { "const": "rag-answer-quality-and-repository-coverage-v1" },
    "phaseId": { "type": "string", "pattern": "^L(?:0[0-9]|10)$" },
    "executionPredecessor": {
      "oneOf": [{ "type": "string", "pattern": "^L(?:0[0-9]|10)$" }, { "type": "null" }]
    },
    "status": { "enum": ["draft", "accepted"] },
    "decision": { "enum": ["PENDING", "GO", "NO_GO", "BLOCKED"] },
    "branch": { "type": "string", "minLength": 1 },
    "offlineProgrammeBinding": { "$ref": "#/$defs/offlineBinding" },
    "phaseStartSha": { "$ref": "#/$defs/gitSha" },
    "phaseEndSha": { "$ref": "#/$defs/gitSha" },
    "controllerRouting": { "$ref": "#/$defs/agentRouting" },
    "reviewerRouting": { "$ref": "#/$defs/agentRouting" },
    "phaseReview": { "$ref": "#/$defs/phaseReview" },
    "capabilityEvidence": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "evidenceArtifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "closesGate": { "oneOf": [{ "type": "string", "pattern": "^[a-z0-9-]+$" }, { "type": "null" }] },
    "remainingResidualGates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "completedAt": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "acceptedAt": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "agentId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^docs/superpowers/rag-upgrade/execution-artifacts/rag-answer-quality-and-repository-coverage-v1/L(?:0[0-9]|10)/"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "classification"],
      "properties": {
        "path": { "$ref": "#/$defs/artifactPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "classification": { "enum": ["sanitized-route", "redacted-evidence", "review-report", "operation-manifest"] }
      }
    },
    "routeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "sha256"],
      "properties": {
        "source": { "enum": ["codex-host-runtime-metadata", "codex-dispatch-metadata"] },
        "path": { "$ref": "#/$defs/artifactPath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "agentRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "runtimeHost",
        "provider",
        "plannedModel",
        "actualModel",
        "plannedReasoning",
        "actualReasoning",
        "providerMappingUsed",
        "fallbackUsed",
        "escalationUsed",
        "capabilityClass",
        "routeEvidence"
      ],
      "properties": {
        "agentId": { "$ref": "#/$defs/agentId" },
        "runtimeHost": { "const": "codex-desktop" },
        "provider": { "const": "codex" },
        "plannedModel": { "const": "gpt-5.6-sol" },
        "actualModel": { "const": "gpt-5.6-sol" },
        "plannedReasoning": { "enum": ["high", "xhigh"] },
        "actualReasoning": { "enum": ["high", "xhigh"] },
        "providerMappingUsed": { "const": false },
        "fallbackUsed": { "const": false },
        "escalationUsed": { "const": false },
        "capabilityClass": { "const": "frontier-high" },
        "routeEvidence": { "$ref": "#/$defs/routeEvidence" }
      }
    },
    "phaseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerAgentId",
        "baseSha",
        "headSha",
        "diffPackagePath",
        "diffPackageSha256",
        "reportPath",
        "reportSha256",
        "specVerdict",
        "qualityVerdict"
      ],
      "properties": {
        "reviewerAgentId": { "$ref": "#/$defs/agentId" },
        "baseSha": { "$ref": "#/$defs/gitSha" },
        "headSha": { "$ref": "#/$defs/gitSha" },
        "diffPackagePath": { "$ref": "#/$defs/artifactPath" },
        "diffPackageSha256": { "$ref": "#/$defs/sha256" },
        "reportPath": { "$ref": "#/$defs/artifactPath" },
        "reportSha256": { "$ref": "#/$defs/sha256" },
        "specVerdict": { "enum": ["PENDING", "PASS", "FAIL"] },
        "qualityVerdict": { "enum": ["PENDING", "PASS", "FAIL"] }
      }
    },
    "offlineBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remoteBranch",
        "remoteTipSha",
        "programmeReceiptPath",
        "programmeReceiptSha256",
        "programmeReceiptCommit",
        "packageHash"
      ],
      "properties": {
        "remoteBranch": { "type": "string", "minLength": 1 },
        "remoteTipSha": { "$ref": "#/$defs/gitSha" },
        "programmeReceiptPath": { "type": "string", "minLength": 1 },
        "programmeReceiptSha256": { "$ref": "#/$defs/sha256" },
        "programmeReceiptCommit": { "$ref": "#/$defs/gitSha" },
        "packageHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "resolvedPathOrTool",
        "sha256",
        "evidenceArtifactPath",
        "evidenceArtifactSha256",
        "status"
      ],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "resolvedPathOrTool": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "evidenceArtifactPath": { "$ref": "#/$defs/artifactPath" },
        "evidenceArtifactSha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "available" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizationId",
        "authorizer",
        "approvedAt",
        "expiresAt",
        "service",
        "target",
        "actions",
        "actionClasses",
        "scope",
        "dataExposure",
        "expectedStateChange",
        "costCeiling",
        "rollback",
        "stopConditions",
        "destructive"
      ],
      "properties": {
        "authorizationId": { "type": "string", "minLength": 1 },
        "authorizer": { "type": "string", "minLength": 1 },
        "approvedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "service": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "actionClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "scope": { "type": "string", "minLength": 1 },
        "dataExposure": { "type": "string", "minLength": 1 },
        "expectedStateChange": { "type": "string", "minLength": 1 },
        "costCeiling": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 },
        "stopConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "destructive": { "type": "boolean" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "operationClass",
        "service",
        "target",
        "commandOrAction",
        "expected",
        "performedAt",
        "outcome",
        "preStateSha256",
        "postStateSha256",
        "rollbackEvidence"
      ],
      "properties": {
        "approvalId": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "operationClass": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "service": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "commandOrAction": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "performedAt": { "$ref": "#/$defs/timestamp" },
        "outcome": { "enum": ["passed", "failed", "blocked", "not-run"] },
        "preStateSha256": { "$ref": "#/$defs/sha256" },
        "postStateSha256": { "$ref": "#/$defs/sha256" },
        "rollbackEvidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
