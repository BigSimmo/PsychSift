# syntax=docker/dockerfile:1
# PsychSift ingestion worker (Node pipeline + Python OCR stack).
# See docs/deployment-architecture.md for why the worker ships as a
# container instead of completing the edge-agent migration.
#
# Runtime contents (2026-07-13 audit, finding 12 — slimmed):
#   - Node 24 + PRODUCTION-ONLY node_modules: the worker runs as a
#     prebuilt esbuild bundle (dist/worker/index.mjs), so tsx and the rest
#     of the dev toolchain never reach the image.
#   - Tesseract OCR (Debian package, bundles English language data).
#   - Python venv with worker/python/requirements.txt (PyMuPDF, Pillow,
#     pytesseract). The venv's `python` matches the PYTHON_BIN default.
#   - Packet B4 (docs/rag-improvement/README.md §B4, Gate B PASS 2026-08-18):
#     a SECOND, isolated Python venv (/opt/docling-venv) built from the Gate B
#     lab's hashed lock (eval/docling/requirements.txt, CPU-only torch) plus docling's models baked at build time
#     (/opt/docling-models). Consumed only by worker/python/shadow_docling_extract.py
#     when WORKER_DOCUMENT_EXTRACTOR_MODE=shadow; the OCR venv is untouched
#     (numpy 1.26 vs 2.4 forces the split). Not enabling shadow costs nothing at
#     run time — the mode defaults to "legacy" and is set as a Railway variable.
#
# Build: docker build -f Dockerfile.worker -t clinical-kb-worker .
# Run:   docker run --env-file <secrets> clinical-kb-worker
# Secrets are injected at run time; nothing is baked into the image.

# Dev-inclusive install + bundle. scripts/build-worker.mjs resolves the
# `server-only` marker to the standalone stub at build time (the job
# run-tsx.mjs previously did at runtime) and keeps npm packages external,
# so the bundle resolves them from the runner's production node_modules.
FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS node-base
FROM python:3.11-slim-trixie@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce AS python-runtime-base

FROM node-base AS build
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
COPY scripts/check-node-engine.cjs scripts/check-node-engine.cjs
COPY scripts/install-git-hooks.mjs scripts/install-git-hooks.mjs
COPY scripts/check-installed-lock-parity.mjs scripts/check-installed-lock-parity.mjs
COPY scripts/lib/is-entrypoint.mjs scripts/lib/is-entrypoint.mjs
# Same install-retry contract as the app Dockerfile (registry ECONNRESET flakes).
RUN for attempt in 1 2 3; do \
      npm ci --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 && break; \
      if [ "$attempt" -eq 3 ]; then exit 1; fi; \
      sleep $((attempt * 10)); \
    done
COPY . .
ARG RAILWAY_GIT_COMMIT_SHA=
ARG GITHUB_SHA=
ARG SOURCE_COMMIT_SHA=
ARG COMMIT_SHA=
ARG SENTRY_RELEASE=
ENV RAILWAY_GIT_COMMIT_SHA=${RAILWAY_GIT_COMMIT_SHA}
ENV GITHUB_SHA=${GITHUB_SHA}
ENV SOURCE_COMMIT_SHA=${SOURCE_COMMIT_SHA}
ENV COMMIT_SHA=${COMMIT_SHA}
ENV SENTRY_RELEASE=${SENTRY_RELEASE}
# supabase/migrations is only present in the build context, not the slim
# runtime image, so the deploy pre-deploy gate's manifest of migration
# versions this build expects is baked in now and copied into the runner
# below (see scripts/deploy/write-migration-manifest.mjs).
RUN node scripts/deploy/write-migration-manifest.mjs
RUN node scripts/deploy/write-release-manifest.mjs
RUN node scripts/build-worker.mjs

# Production-only node_modules for the runtime stage. The preinstall/
# postinstall lifecycle scripts must be present in every npm-ci stage.
FROM node-base AS prod-deps
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
COPY scripts/check-node-engine.cjs scripts/check-node-engine.cjs
COPY scripts/install-git-hooks.mjs scripts/install-git-hooks.mjs
COPY scripts/check-installed-lock-parity.mjs scripts/check-installed-lock-parity.mjs
RUN for attempt in 1 2 3; do \
      npm ci --omit=dev --ignore-scripts --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 && break; \
      if [ "$attempt" -eq 3 ]; then exit 1; fi; \
      sleep $((attempt * 10)); \
    done

# Build security backports using the same signed Trixie sources and ordinary
# Debian packaging. Compilers/source trees never enter the runtime image.
# The immutable snapshot deb-src keeps the exact pinned source versions in
# worker/native/components/*.json resolvable after Debian supersedes them on
# the live mirrors; the .dsc hash check still pins the bytes. Its Release file
# is archive-signed but expired, hence check-valid-until=no on that line only.
FROM python-runtime-base AS native-security-build-base
RUN printf '%s\n' \
    'deb-src [signed-by=/usr/share/keyrings/debian-archive-keyring.pgp check-valid-until=no] https://snapshot.debian.org/archive/debian/20261021T000000Z trixie main' \
    'deb-src [signed-by=/usr/share/keyrings/debian-archive-keyring.pgp] https://deb.debian.org/debian trixie main' \
    'deb-src [signed-by=/usr/share/keyrings/debian-archive-keyring.pgp] https://deb.debian.org/debian-security trixie-security main' \
    > /etc/apt/sources.list.d/worker-native-security-sources.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends build-essential dpkg-dev quilt
COPY worker/native/build_security_debs.py worker/native/test_build_security_debs.py /tmp/worker-native/
RUN python3 /tmp/worker-native/test_build_security_debs.py

FROM native-security-build-base AS native-util-linux
COPY worker/native/components/util-linux.json /tmp/worker-native/components/util-linux.json
COPY worker/native/patches/util-linux/ /tmp/worker-native/patches/util-linux/
COPY worker/native/util-linux-regressions.sh /tmp/worker-native/util-linux-regressions.sh
RUN python3 /tmp/worker-native/build_security_debs.py util-linux

FROM native-security-build-base AS native-tesseract
COPY worker/native/components/tesseract.json /tmp/worker-native/components/tesseract.json
COPY worker/native/patches/tesseract/ /tmp/worker-native/patches/tesseract/
COPY worker/native/tesseract-regressions.sh /tmp/worker-native/tesseract-regressions.sh
COPY worker/native/tesseract-adapted-templates-test.cc /tmp/worker-native/tesseract-adapted-templates-test.cc
RUN python3 /tmp/worker-native/build_security_debs.py tesseract

FROM native-security-build-base AS native-ncurses
COPY worker/native/components/ncurses.json /tmp/worker-native/components/ncurses.json
COPY worker/native/patches/ncurses/ /tmp/worker-native/patches/ncurses/
COPY worker/native/ncurses-regressions.sh /tmp/worker-native/ncurses-regressions.sh
RUN python3 /tmp/worker-native/build_security_debs.py ncurses

FROM native-security-build-base AS native-libxml2
COPY worker/native/components/libxml2.json /tmp/worker-native/components/libxml2.json
COPY worker/native/patches/libxml2/ /tmp/worker-native/patches/libxml2/
COPY worker/native/libxml2-tests/ /tmp/worker-native/libxml2-tests/
COPY worker/native/libxml2-regressions.sh /tmp/worker-native/libxml2-regressions.sh
RUN python3 /tmp/worker-native/build_security_debs.py libxml2

FROM python-runtime-base AS runner
COPY --from=node-base /usr/local/bin/node /usr/local/bin/node
COPY --from=native-util-linux /out/ /tmp/worker-native-debs/
COPY --from=native-tesseract /out/ /tmp/worker-native-debs/
COPY --from=native-ncurses /out/ /tmp/worker-native-debs/
COPY --from=native-libxml2 /out/ /tmp/worker-native-debs/
COPY worker/native/build_security_debs.py /tmp/worker-native-verify.py
# libgl1 + libglib2.0-0t64 are OpenCV's runtime shared libraries: docling's rapidocr
# stage imports cv2 during `docling-tools models download` and again at run time,
# and the slim base ships neither (Gate B run 32165911181 failed the prefetch with
# `ImportError: libGL.so.1`). ca-certificates covers the build-time model fetch.
# Keep the production locks' Python 3.11 interpreter; Trixie's distro Python is
# 3.13. Explicitly upgrade Perl and reject a stale security repository.
# Backport only curl and its three HTTP/3 libraries; all other backports are
# forbidden. ngtcp2 1.22.1 also avoids introducing CVE-2026-40170.
RUN printf '%s\n' \
    'deb [signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] https://deb.debian.org/debian trixie-backports main' \
    > /etc/apt/sources.list.d/worker-native-backports.list \
  && printf '%s\n' \
    'Package: libcurl4t64 libnghttp3-9 libngtcp2-16 libngtcp2-crypto-ossl0' \
    'Pin: release n=trixie-backports' \
    'Pin-Priority: 990' \
    '' \
    'Package: *' \
    'Pin: release n=trixie-backports' \
    'Pin-Priority: -1' \
    > /etc/apt/preferences.d/worker-native-backports \
  && apt-get update \
  && apt-get install -y --no-install-recommends --no-remove perl-base tesseract-ocr ca-certificates libgl1 libglib2.0-0t64 \
    libcurl4t64=8.21.0-2~bpo13+1 libnghttp3-9=1.15.0-1~bpo13+1 \
    libngtcp2-16=1.22.1-1~bpo13+1 libngtcp2-crypto-ossl0=1.22.1-1~bpo13+1 \
    /tmp/worker-native-debs/*.deb \
  && mkdir -p /usr/share/psychsift/native-security \
  && cp /tmp/worker-native-debs/*.json /usr/share/psychsift/native-security/ \
  && dpkg --compare-versions "$(dpkg-query --show --showformat='${Version}' perl-base)" ge 5.40.1-6+deb13u1 \
  && dpkg --compare-versions "$(dpkg-query --show --showformat='${Version}' libcurl4t64)" ge 8.21.0-2~bpo13+1 \
  && dpkg --compare-versions "$(dpkg-query --show --showformat='${Version}' libngtcp2-16)" ge 1.22.1-1~bpo13+1 \
  && groupadd --gid 1000 node \
  && useradd --uid 1000 --gid node --shell /bin/sh --create-home node \
  && python3 -c "import sys; assert sys.version_info[:2] == (3, 11)" \
  && python3 -m pip uninstall -y setuptools \
  && for helper in /usr/bin/mount /usr/bin/umount; do \
       if [ -e "$helper" ]; then chmod u-s,g-s "$helper"; fi; \
     done \
  && rm -rf /var/lib/apt/lists/* /usr/local/lib/node_modules/npm /opt/yarn-* /tmp/worker-native-debs \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg
RUN python3 /tmp/worker-native-verify.py --verify-installed /usr/share/psychsift/native-security \
  && rm /tmp/worker-native-verify.py
# Optional ruled-table OCR: bake the official, hash-pinned cell model at build time.
# The extraction flag remains off; the runtime never downloads model data.
RUN python3 - <<'PYMODEL'
import hashlib
from pathlib import Path
import urllib.request
model_dir = Path("/opt/psychsift-ocr-models")
model_dir.mkdir(mode=0o755)
model = model_dir / "Latin.traineddata"
digest = hashlib.sha256()
size = 0
with urllib.request.urlopen("https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/script/Latin.traineddata", timeout=60) as response, model.open("wb") as output:
    while chunk := response.read(1024 * 1024):
        size += len(chunk)
        if size > 89_384_811:
            raise RuntimeError("OCR cell model exceeds pinned size")
        digest.update(chunk)
        output.write(chunk)
if size != 89_384_811 or digest.hexdigest() != "6dbdaf8ecc6c40f025c2648bf3b3f3fbffe073e1fd2df2047fde2e2b2f020d53":
    raise RuntimeError("OCR cell model does not match pinned identity")
model.chmod(0o644)
PYMODEL
COPY worker/python/ocr-model-LICENSE.txt /opt/psychsift-ocr-models/LICENSE
WORKDIR /app
COPY worker/python/requirements.txt worker/python/requirements.txt
RUN python3 -m venv /opt/ocr-venv
RUN /opt/ocr-venv/bin/pip install --no-cache-dir --upgrade --require-hashes -r worker/python/requirements.txt \
  && /opt/ocr-venv/bin/pip check
# Packet B4: docling shadow-extraction venv from the Gate B lab's hashed lock (read-only
# consumption; the lock is regenerated only via `npm run generate:docling-lab-lock`).
# Same image shape as eval/docling/Dockerfile, so shadow measurements are taken with the
# extractor identity the decision record names. Kept in its own cacheable layer set.
COPY eval/docling/requirements.txt /tmp/docling-requirements.txt
RUN python3 -m venv /opt/docling-venv \
  && /opt/docling-venv/bin/pip install --no-cache-dir --require-hashes -r /tmp/docling-requirements.txt \
  && /opt/docling-venv/bin/pip check \
  && rm /tmp/docling-requirements.txt
# Prefetch docling's models at build time: HF_HUB_OFFLINE=1 below forbids any run-time
# fetch, so a missing model fails the shadow run loudly instead of reaching HuggingFace
# from a production worker. The Python client is hash-locked in
# eval/docling/requirements.txt, but the HuggingFace model artifacts themselves carry
# no version argument at all — docling-tools has no --revision flag, so the weights are
# whatever those repositories hold on build day. A bad upstream release would change how
# clinical PDFs are read with no commit here and nothing in the log to notice.
#
# So the download is followed, in this same layer, by a digest check against
# eval/docling/model-artifacts.json: a mismatch exits non-zero and fails the build. While
# that manifest records no digest yet it prints the one the download produced (the block
# to paste in) instead of failing, because the digest can only be learned by building.
# See the header of verify-model-artifacts.mjs for the whole contract.
COPY eval/docling/verify-model-artifacts.mjs eval/docling/model-artifacts.json /tmp/docling-verify/
RUN /opt/docling-venv/bin/docling-tools models download --output-dir /opt/docling-models \
  && node /tmp/docling-verify/verify-model-artifacts.mjs \
    --models-dir /opt/docling-models \
    --manifest /tmp/docling-verify/model-artifacts.json \
  && chmod -R a+rX /opt/docling-models \
  && rm -rf /tmp/docling-verify
ARG RAILWAY_GIT_COMMIT_SHA=
ARG GITHUB_SHA=
ARG SOURCE_COMMIT_SHA=
ARG COMMIT_SHA=
ARG SENTRY_RELEASE=
ENV WORKER_DOCLING_PYTHON_BIN=/opt/docling-venv/bin/python
ENV DOCLING_ARTIFACTS_PATH=/opt/docling-models
ENV TORCHDYNAMO_DISABLE=1
ENV HF_HUB_OFFLINE=1
ENV PATH="/opt/ocr-venv/bin:${PATH}"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV NODE_ENV=production
ENV RAILWAY_GIT_COMMIT_SHA=${RAILWAY_GIT_COMMIT_SHA}
ENV COMMIT_SHA=${COMMIT_SHA}
ENV SENTRY_RELEASE=${SENTRY_RELEASE}
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
# Railway deploy pre-deploy gate (docs/worker-deploy-runbook.md §0): blocks/
# observes this service's deploy until migrations this build expects are live.
COPY --from=build /app/deploy/expected-migrations.json ./deploy/expected-migrations.json
COPY --from=build /app/deploy/release-identity.json ./deploy/release-identity.json
COPY --from=build /app/scripts/deploy/await-migrations.mjs ./scripts/deploy/await-migrations.mjs
COPY --from=build /app/scripts/deploy/migration-versions.mjs ./scripts/deploy/migration-versions.mjs
COPY worker/python worker/python
# Python is outside the TypeScript/Vitest toolchain. Fail the image build on a
# syntax error or a broken extraction-budget contract instead of discovering it
# only when the deployed worker processes its first PDF.
RUN python -m compileall -q worker/python \
  && python -m unittest discover -s worker/python -p "test_*.py" \
  && find worker/python -type d -name __pycache__ -prune -exec rm -rf '{}' + \
  && rm -f worker/python/test_*.py
COPY package.json ./package.json
COPY worker/native/check_docling_runtime.py /tmp/check-native-docling.py
USER node
# The runtime validator proves the bundle, Node, Python and module resolution
# before the image is promoted. It never calls Supabase/OpenAI or claims jobs.
RUN node dist/worker/validate-runtime.mjs
RUN timeout 180 /opt/docling-venv/bin/python /tmp/check-native-docling.py
LABEL org.opencontainers.image.source="https://github.com/BigSimmo/PsychSift"
LABEL org.opencontainers.image.title="PsychSift ingestion worker"
LABEL org.opencontainers.image.description="Node + Python OCR ingestion worker for the PsychSift medical guideline RAG knowledge base"
LABEL org.opencontainers.image.licenses="UNLICENSED"
STOPSIGNAL SIGTERM
# Container-runtime health probe for Docker/Compose. worker/health.ts binds
# /health on WORKER_HEALTH_PORT, falling back to Railway's PORT; with neither
# set the health server is off and the probe reports unhealthy rather than
# claiming a check it could not run. Railway ignores HEALTHCHECK and keeps
# using railway.worker.json's healthcheckPath (/health on PORT), so this does
# not change Railway deploy gating.
# Kept on one line: tests/tsx-server-only-runner.test.ts treats the first line
# starting with CMD as the worker entrypoint.
HEALTHCHECK --interval=30s --timeout=20s --start-period=60s --retries=3 CMD node -e "const p=process.env.WORKER_HEALTH_PORT||process.env.PORT;if(!p){console.error('worker health server disabled: set WORKER_HEALTH_PORT or PORT');process.exit(1)}fetch('http://127.0.0.1:'+p+'/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Long-poll worker; WORKER_* env vars control claim batch size, concurrency,
# and the stale-claim window (see src/lib/env.ts).
#
# The bundle already has `server-only` stubbed (scripts/build-worker.mjs), so
# no runtime loader hook is needed. Guarded by
# tests/tsx-server-only-runner.test.ts.
CMD ["node", "dist/worker/index.mjs"]
