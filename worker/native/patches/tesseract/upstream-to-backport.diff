+diff --git a/unittest/genericvector_rejected_cleanup_test.cc b/unittest/genericvector_rejected_cleanup_test.cc
+new file mode 100644
+--- /dev/null
++++ b/unittest/genericvector_rejected_cleanup_test.cc
+@@ -0,0 +1,72 @@
++// PsychSift hardening beyond upstream CVE-2026-88051: rejected counts must
++// leave the vector's cleanup bound valid. Existing upstream tests are unchanged.
++// SPDX-License-Identifier: Apache-2.0
++#include "include_gunit.h"
++#include "genericvector.h"
++#include "serialis.h"
++#include <cstdint>
++#include <vector>
++
++namespace tesseract {
++namespace {
++void PutCleanupInt32(std::vector<char> *bytes, int32_t value) {
++  uint32_t bits = static_cast<uint32_t>(value);
++  for (int i = 0; i != 4; ++i) {
++    bytes->push_back(static_cast<char>((bits >> (8 * i)) & 255));
++  }
++}
++std::vector<char> CleanupVectorBytes(int32_t used) {
++  std::vector<char> bytes;
++  PutCleanupInt32(&bytes, 4);
++  PutCleanupInt32(&bytes, used);
++  if (used == 2) {
++    PutCleanupInt32(&bytes, 17);
++    PutCleanupInt32(&bytes, 23);
++  }
++  return bytes;
++}
++
++TEST(GenericVectorCleanupTest, RejectedCountsPreserveSizeAndCallbackCleanup) {
++  for (int32_t used : {int32_t{65536}, int32_t{-1}}) {
++    for (int existing_count : {0, 1}) {
++      std::vector<char> bytes = CleanupVectorBytes(used);
++      TFile file;
++      ASSERT_TRUE(file.Open(bytes.data(), bytes.size()));
++      GenericVector<int> vector;
++      int cleaned = 0;
++      vector.set_clear_callback([&cleaned](int value) {
++        EXPECT_EQ(value, 17);
++        ++cleaned;
++      });
++      if (existing_count) vector.push_back(17);
++      EXPECT_FALSE(vector.read(&file, [](TFile *f, int *p) { return f->DeSerialize(p); }));
++      EXPECT_EQ(vector.size(), existing_count);
++      // If this assertion fails on the original upstream patch, avoid an
++      // out-of-bounds cleanup while still retaining the failed expectation.
++      if (vector.size() != existing_count) vector.set_clear_callback(nullptr);
++      vector.clear();
++      EXPECT_EQ(cleaned, existing_count);
++      EXPECT_EQ(vector.size(), 0);
++    }
++  }
++}
++
++TEST(GenericVectorCleanupTest, ValidCountsRunCleanupForEachElement) {
++  std::vector<char> bytes = CleanupVectorBytes(2);
++  TFile file;
++  ASSERT_TRUE(file.Open(bytes.data(), bytes.size()));
++  GenericVector<int> vector;
++  int cleaned = 0;
++  int sum = 0;
++  vector.set_clear_callback([&cleaned, &sum](int value) {
++    ++cleaned;
++    sum += value;
++  });
++  ASSERT_TRUE(vector.read(&file, [](TFile *f, int *p) { return f->DeSerialize(p); }));
++  EXPECT_EQ(vector.size(), 2);
++  vector.clear();
++  EXPECT_EQ(cleaned, 2);
++  EXPECT_EQ(sum, 40);
++}
++} // namespace
++} // namespace tesseract
